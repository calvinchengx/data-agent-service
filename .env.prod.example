# .env.prod — production. Copy to .env.prod and fill in.
#
# Discipline rule 2: switching environments is THIS FILE, not a code path.
# Every key below is read by the same code that runs against the emulators;
# `make seed test eval load ENV=prod` runs the identical harnesses.
#
# Blank values are things only your tenant knows. The ones already filled in
# are either fixed by Azure or a deliberate production choice, flagged below.
#
#   DAS_ENTRA_TLS_INSECURE=false   real certificates; never true here
#   DAS_APIM_VALIDATE_JWT=true     real APIM validates the audience it is told
#                                  to (the local stack cannot — upstream #7)
#   DAS_EXECUTOR=go                ~8x the throughput at a thirtieth of the
#                                  image; see docs/adr/0001-two-executors.md
#   DAS_HARNESS_AUTH=device        a production tenant refuses the password
#                                  grant; `token` for CI, with DAS_TOKEN_<UPN>
#   DAS_ROLE_SOURCE=group          identity-governance tools provision groups
#
# The image pins and host ports below are for the local compose stack only and
# are ignored here; they are kept so the two files can be diffed.

# Copy to .env (local emulators) or .env.prod (real Azure). Every DAS_* key is
# read by the service/agent/harnesses; *_VERSION and *_PORT keys by compose.
# Discipline rule 2: switching environments is THIS file only — no code paths.

# ---- dependency image pins (the BOM) -------------------------------------
ENTRA_EMULATOR_VERSION=
KEYVAULT_EMULATOR_VERSION=
ARM_EMULATOR_VERSION=
FABRIC_EMULATOR_VERSION=
APIM_EMULATOR_VERSION=

# ---- host ports -----------------------------------------------------------
ENTRA_PORT=
KEYVAULT_PORT=
ARM_PORT=
APIM_PORT=
FABRIC_PORT=
FABRIC_TDS_PORT=
OM_PORT=
EXECUTOR_PORT=

# ---- identity -------------------------------------------------------------
DAS_ENTRA_ISSUER=
DAS_ENTRA_JWKS_URL=
DAS_ENTRA_TLS_INSECURE=false
DAS_TENANT_ID=
# public client the user signs into (seeded SPA app in entra-emulator)
DAS_AGENT_CLIENT_ID=
DAS_AGENT_AUDIENCE=
# confidential app the executor authenticates as for OBO (FIC-backed by MI)
DAS_QUERY_SVC_CLIENT_ID=
# seed-time confidential client (client_credentials); prod: an app with Fabric + Graph roles
DAS_SEED_CLIENT_ID=
DAS_SEED_CLIENT_SECRET=
DAS_SQL_AUDIENCE=https://database.windows.net
# Azure SQL's delegated scope; what OBO asks for so the USER reaches the engine
DAS_SQL_SCOPE=https://database.windows.net/user_impersonation
# The middle tier == the app that owns DAS_AGENT_AUDIENCE (OBO addresses the
# user's token to the exchanging application). seed/apps.py reports it.
DAS_MIDDLE_TIER_CLIENT_ID=
DAS_EXECUTOR_SECRET_NAME=das-executor-client-secret
DAS_REQUIRED_SCOPE=access_as_user
DAS_FABRIC_AUDIENCE=https://api.fabric.microsoft.com

# ---- service identity (App Service managed-identity protocol) ------------
IDENTITY_ENDPOINT=
IDENTITY_HEADER=
AZURE_TOKEN_CREDENTIALS=

# ---- endpoints (as seen from INSIDE the compose network; prod = real hosts) --
# management plane (Host: management.azure.localhost) and gateway share the port
DAS_APIM_MGMT=
DAS_APIM_SUBSCRIPTION=
DAS_APIM_RESOURCE_GROUP=
DAS_APIM_SERVICE=
DAS_EXECUTOR_URL=
DAS_OM_MCP_URL=
# Gateway-side token validation. true is the production shape; the local stack
# turns it off because the pinned apim-emulator's validate-jwt accepts only
# ARM-audience tokens (docs/upstream-issues.md #7). The executor validates the
# same token itself either way.
DAS_APIM_VALIDATE_JWT=true
DAS_RATE_CALLS=600
DAS_RATE_WINDOW_S=60
DAS_APIM_BASE=
DAS_OM_SUBSCRIPTION_KEY=
DAS_OM_MCP_PATH=
DAS_WAREHOUSE_MCP_PATH=
DAS_FABRIC_API=https://api.fabric.microsoft.com
DAS_OM_URL=
DAS_KEYVAULT_URL=

# ---- sources (JSON list; om_service_fqn joins the semantic layer) ---------
# tds_server (optional) overrides the advertised connectionString only when it is
# not dialable from where the service runs (Docker port remap); blank in prod.
DAS_SOURCES=
DAS_OM_SCOPE=
DAS_OM_CONTEXT_MODE=
DAS_SQL_MAX_ROWS=500
DAS_SQL_TIMEOUT_S=30
DAS_SQL_ALLOWED_SCHEMAS=dbo
# Who may read what, above what the source enforces. Rules narrow, never widen.
# Column rules express what a warehouse grant cannot: a grant reaches a table,
# the catalog knows which columns carry personal data. seed/authz.py owns these.
# Where a caller's role comes from: appRole (application role assignments on
# this API) | group (security-group membership, what an identity-governance
# tool such as SailPoint can provision) | both (union, for migrating).
DAS_ROLE_SOURCE=group
DAS_GROUP_ROLE_MAP=
DAS_ACCESS_RULES=

# ---- executor -------------------------------------------------------------
DAS_EXECUTOR=go
DAS_LOG_LEVEL=

# ---- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=
DAS_MODEL=claude-opus-5
DAS_EFFORT=high
DAS_USER=
DAS_TEST_PASSWORD=
DAS_SKILLS=

# ---- promotion / publishing (Phases 15-16) ---------------------------------
DAS_PROMOTE_ENABLED=
DAS_PROMOTE_MIN_USERS=
DAS_PROMOTE_MIN_RUNS=
DAS_PROMOTE_WINDOW_DAYS=
DAS_PROMOTE_ROLES=
DAS_PUBLISH_ENABLED=
DAS_PUBLISH_WORKSPACE_ID=
DAS_PUBLISH_MODE=
