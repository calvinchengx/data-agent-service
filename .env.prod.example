# Production. Copy to .env.prod and fill in; `make ... ENV=prod` reads it.
#
# The rule this file exists to keep: nothing below is a code path. Every
# difference between a laptop and a tenant lives here, and `scripts/preflight.py`
# refuses a file that still describes a development stack.
#
# Values marked <from deploy> are outputs of infra/terraform; values marked
# <from runbook> are created by the az commands in docs/10-production.md.

# ---- identity --------------------------------------------------------------
DAS_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
DAS_ENTRA_JWKS_URL=
DAS_ENTRA_TLS_INSECURE=false
DAS_TENANT_ID=<tenant-id>
DAS_AGENT_CLIENT_ID=<from runbook: public client app>
DAS_AGENT_AUDIENCE=api://data-agent-service
DAS_MIDDLE_TIER_CLIENT_ID=<from deploy: api_app_client_id>
DAS_REQUIRED_SCOPE=access_as_user
DAS_SQL_AUDIENCE=https://database.windows.net
DAS_SQL_SCOPE=https://database.windows.net/user_impersonation
DAS_FABRIC_AUDIENCE=https://api.fabric.microsoft.com
# The name of the executor's fallback credential in Key Vault. Preferred path
# is the federated managed identity, which needs no secret at all.
DAS_EXECUTOR_SECRET_NAME=das-executor-client-secret
# The identity the platform injects is the one to use; naming a credential
# explicitly is how a deployment ends up using the wrong one.
AZURE_TOKEN_CREDENTIALS=ManagedIdentityCredential

# Where a caller's role is read from. `group` is what an identity-governance
# tool provisions into; see docs/05-authorization.md.
DAS_ROLE_SOURCE=group
# WHICH APPLICATION may hold a user's token. A genuine corporate sign-in from a
# PERSONAL AI client is still a genuine sign-in -- authorization is not
# bypassed, but the data lands in a consumer subscription. List the approved
# clients here (the agent app, and any desktop AI client an administrator has
# consented to). Empty means unrestricted, which is only right when the
# tenant's own consent settings are already the control.
DAS_ALLOWED_CLIENT_IDS=<from runbook: public client app>,<approved AI client app ids>
DAS_GROUP_ROLE_MAP={"DAS-Analysts":"Data.Analyst","DAS-Finance":"Data.Finance","DAS-Admins":"Data.Admin"}

# ---- endpoints -------------------------------------------------------------
DAS_APIM_BASE=https://<from deploy: apimGatewayUrl>
DAS_APIM_MGMT=https://management.azure.com
DAS_APIM_SUBSCRIPTION=<subscription-id>
DAS_APIM_RESOURCE_GROUP=<resource-group>
DAS_APIM_SERVICE=<from deploy: apimName>
DAS_EXECUTOR_URL=<from deploy: executorUrl>
DAS_PUBLIC_BASE_URL=https://<from deploy: apimGatewayUrl>/warehouse/mcp
DAS_WAREHOUSE_MCP_PATH=/warehouse/mcp
DAS_OM_MCP_PATH=/om/mcp
DAS_FABRIC_API=https://api.fabric.microsoft.com
DAS_OM_URL=https://<your-openmetadata-host>
DAS_OM_MCP_URL=https://<your-openmetadata-host>/mcp
# Gateway credential for the catalog route, from `az apim subscription`.
DAS_OM_SUBSCRIPTION_KEY=<from runbook: apim subscription key>
# Narrow the catalog to one domain or service when a deployment should not see
# the whole estate. Empty means everything the bot may read.
DAS_OM_SCOPE=
DAS_OM_CONTEXT_MODE=base
DAS_KEYVAULT_URL=<from deploy: vaultUri>

# ---- gateway ---------------------------------------------------------------
# On in production: real API Management validates the audience a policy declares
# (the local stack turns this off only because the pinned emulator cannot —
# docs/upstream-issues.md #7).
DAS_APIM_VALIDATE_JWT=true
DAS_RATE_CALLS=60
DAS_RATE_WINDOW_S=60

# ---- sources ---------------------------------------------------------------
# tds_server is omitted deliberately: production uses the address Fabric
# advertises. authz_tier=user means the warehouse applies each caller's own
# permissions.
# Which source a call is about when it does not say. Leave empty to REQUIRE
# the name once more than one source is configured.
DAS_DEFAULT_SOURCE=
DAS_SOURCES=[{"name":"contoso_warehouse","kind":"fabric","dialect":"tsql","authz_tier":"user","om_service_fqn":"fabric_contoso","workspace":"contoso-analytics","item":"contoso_warehouse"}]
DAS_SQL_MAX_ROWS=500
DAS_SQL_TIMEOUT_S=30
DAS_SQL_ALLOWED_SCHEMAS=dbo
DAS_ACCESS_RULES=[{"role":"Data.Admin","allow_tables":["*"],"deny_columns":[]},{"role":"Data.Finance","allow_tables":["dbo.*","support.*"],"deny_columns":[]},{"role":"Data.Analyst","allow_tables":["dbo.*","support.*"],"deny_columns":["dbo.dim_customer.email","dbo.dim_party.email","dbo.dim_customer.name","support.customers.email","support.agents.email"]},{"role":"*","allow_tables":["dbo.*","support.*"],"deny_columns":[]}]

# ---- agent -----------------------------------------------------------------
ANTHROPIC_API_KEY=
DAS_MODEL=claude-opus-5
DAS_EFFORT=high
DAS_SKILLS=om-grounded-sql,result-presentation
DAS_LOG_LEVEL=INFO

# ---- harness sign-in -------------------------------------------------------
# How the unattended checks obtain a token per persona against a tenant that
# refuses the password grant. `device` prompts interactively; `token` reads
# DAS_TOKEN_<UPN> for CI. See agent/identity.py.
DAS_HARNESS_AUTH=device

# ---- present, and deliberately empty ---------------------------------------
# Every setting the code reads appears in this file, so nobody discovers a
# missing one in production. These are the ones that must have NO value here:
# listing them empty documents them without handing anyone a credential, and
# `scripts/preflight.py` fails the file if any of them is filled in.

# The seeds authenticate as the operator (`az login`), not as an app with a
# secret checked into a settings file.
DAS_SEED_CLIENT_ID=
DAS_SEED_CLIENT_SECRET=

# Personas sign themselves in. A production tenant refuses the password grant,
# and DAS_HARNESS_AUTH above chooses how the unattended checks get a token.
DAS_USER=
DAS_TEST_PASSWORD=

# The middle tier is DAS_MIDDLE_TIER_CLIENT_ID above; this older spelling is
# still read for compatibility and should stay empty.
DAS_QUERY_SVC_CLIENT_ID=

# The deployed image decides which executor implementation is running; the
# Terraform variable records it for the operator, this does not select it.
DAS_EXECUTOR=

# A deliberately unapproved application, registered by the seed so the client
# allow-list can be witnessed with a genuine token. A real tenant must NOT have
# one: the assurance there comes from admin consent and Conditional Access
# deciding which applications exist at all.
DAS_UNAPPROVED_CLIENT_ID=

# ---- later phases, off until they ship -------------------------------------
DAS_PROMOTE_ENABLED=false
DAS_PROMOTE_MIN_USERS=3
DAS_PROMOTE_MIN_RUNS=10
DAS_PROMOTE_WINDOW_DAYS=30
DAS_PROMOTE_ROLES=Data.Admin,Data.Analyst
# Which dashboard tools a released candidate is published to. Every named
# target is offered every candidate and each says whether it can take it, so
# a question that recurs is answered wherever people look. A name with no
# target built behind it is refused at startup rather than silently doing
# nothing. Built: powerbi. See docs/00-plan.md §20.
DAS_DASHBOARD_TARGETS=powerbi
# Laplace noise on released counts. The user threshold above protects a small
# population; this blurs the counts of what passes it.
DAS_PROMOTE_EPSILON=1.0
# The pseudonymisation key. In Azure this is a Key Vault reference resolved by
# the app's managed identity -- never a literal here. The job refuses to run
# without one rather than hashing unkeyed, which would be a lookup table over
# a known user list.
DAS_PROMOTE_KEY_SECRET=@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/das-promoter-key/)
DAS_PUBLISH_ENABLED=false
DAS_PUBLISH_WORKSPACE_ID=
DAS_PUBLISH_MODE=directquery
DAS_LLM_BACKEND=
DAS_LLM_BASE_URL=
DAS_LLM_CALLS_PER_MINUTE=
DAS_LLM_TOKENS_PER_MINUTE=

# The subject of the federated credential CI signs in with. Naming a repository
# and ref here is what makes `make eval ENV=prod` runnable from a workflow with
# no secret anywhere: GitHub hands the job a short-lived OIDC token, Entra
# trusts this exact subject, and exchanges it for an app token. A wrong value
# does not fail loudly -- it simply trusts nobody -- so it is set deliberately
# or left empty.
DAS_CI_SUBJECT=repo:<org>/<repo>:ref:refs/heads/main

# ---- the harness's local-network shims: EMPTY in production ---------------
# Every one of these exists because the emulator stack lives inside a docker
# network while the `claude` CLI lives on the host. Against real Azure the
# split does not exist: the tenant is login.microsoftonline.com, the gateway is
# a real APIM host, and a Fabric warehouse answers on
# <workspace>.datawarehouse.fabric.microsoft.com -- all publicly resolvable,
# all with certificates the machine already trusts. A harness on a laptop signs
# in and connects directly, so none of this is needed and all of it must stay
# unset.

# Runs the scorer's SQL inside the compose network, because the Fabric emulator
# is addressed by the workspace in its server name and only that network
# resolves it. Real Fabric resolves publicly.
DAS_SQL_PROXY=

# Overrides the gateway address for a host-side harness, because the local
# gateway answers on a published port rather than its compose hostname. In
# production DAS_APIM_BASE is already the address everyone uses.
DAS_CLAUDE_APIM_BASE=

# The repository path baked into generated stdio client configurations. Only
# the local bridge needs one; a real deployment is a remote HTTPS endpoint.
DAS_HOST_REPO=

# DAS_ACCESS_TOKEN_<AUDIENCE> supplies a token to a process that cannot sign in
# because the tenant is unreachable from it. A production tenant is reachable
# from anywhere, so the harness signs in itself -- see DAS_HARNESS_AUTH.

# ---- absent on purpose, and not listed above -------------------------------
# IDENTITY_ENDPOINT / IDENTITY_HEADER — the platform injects the managed
#   identity; setting them by hand would override the real one.
# *_EMULATOR_VERSION / *_PORT — image pins and published ports for the local
#   compose stack. Production has no compose file.

# --- catalog-carried access rules (docs/00-plan.md §19) ----------------------
# A rule may name a TAG in `deny_tagged` as well as a column. The vocabulary is
# the catalog's: OpenMetadata's own PII.* and PersonalData.*, or a
# classification this organisation invented. Nothing privileges one in code.
#
# With no `deny_tagged` anywhere, none of this is read and the executor never
# contacts the catalog.
DAS_OM_BOT_TOKEN=keyvault:om-bot-das-reader
# How soon a newly tagged column starts being refused.
DAS_TAG_REFRESH_S=300
# `closed` or `last-known` when the catalog cannot be read. Neither applies on
# a COLD start: with `deny_tagged` configured and no tag set ever read, the
# executor refuses to serve rather than answer with fewer denials than it was
# configured to apply.
DAS_TAG_FAILURE=closed

# --- the catalog, as the caller's role sees it --------------------------------
# OpenMetadata's MCP server is proxied at /om/mcp as the read-only bot for the
# caller's role. Most permissive role FIRST; a caller holding none of these
# reaches no bot. Written by `seed.authz` from the policies it creates -- the
# value here is the shape, not a thing to type.
DAS_OM_ROLE_BOTS=Data.Finance=keyvault:om-bot-das-finance,Data.Analyst=keyvault:om-bot-das-analyst
