# Copy to .env (local emulators) or .env.prod (real Azure). Every DAS_* key is
# read by the service/agent/harnesses; *_VERSION and *_PORT keys by compose.
# Discipline rule 2: switching environments is THIS file only — no code paths.

# ---- dependency image pins (the BOM) -------------------------------------
ENTRA_EMULATOR_VERSION=0.9.0
KEYVAULT_EMULATOR_VERSION=0.7.0
ARM_EMULATOR_VERSION=0.4.1
FABRIC_EMULATOR_VERSION=0.32.0
APIM_EMULATOR_VERSION=0.4.0

# ---- host ports -----------------------------------------------------------
ENTRA_PORT=8443
KEYVAULT_PORT=8444
ARM_PORT=8445
APIM_PORT=8446
FABRIC_PORT=9443
FABRIC_TDS_PORT=1433
OM_PORT=8585
POSTGRES_PORT=5432
POSTGRES_PASSWORD=das-local-only
EXECUTOR_PORT=8090

# ---- identity -------------------------------------------------------------
DAS_ENTRA_ISSUER=https://entra-emulator:8443/6f89cf12-978b-4d23-ac18-9ef0c127cf87/v2.0
DAS_ENTRA_JWKS_URL=
DAS_ENTRA_TLS_INSECURE=true
DAS_TENANT_ID=6f89cf12-978b-4d23-ac18-9ef0c127cf87
# public client the user signs into (seeded SPA app in entra-emulator)
DAS_AGENT_CLIENT_ID=189c7070-78a3-4c13-aa18-20a2ca5755ca
DAS_AGENT_AUDIENCE=api://data-agent-service
# confidential app the executor authenticates as for OBO (FIC-backed by MI)
DAS_QUERY_SVC_CLIENT_ID=00d88624-f0d7-46f6-a641-6232c2608928
# seed-time confidential client (client_credentials); prod: an app with Fabric + Graph roles
DAS_SEED_CLIENT_ID=00d88624-f0d7-46f6-a641-6232c2608928
DAS_SEED_CLIENT_SECRET=daemon-app-secret
DAS_SQL_AUDIENCE=https://database.windows.net
# Azure SQL's delegated scope; what OBO asks for so the USER reaches the engine
DAS_SQL_SCOPE=https://database.windows.net/user_impersonation
# The middle tier == the app that owns DAS_AGENT_AUDIENCE (OBO addresses the
# user's token to the exchanging application). seed/apps.py reports it.
DAS_MIDDLE_TIER_CLIENT_ID=
DAS_EXECUTOR_SECRET_NAME=das-executor-client-secret
DAS_REQUIRED_SCOPE=access_as_user
DAS_FABRIC_AUDIENCE=https://api.fabric.microsoft.com

# ---- service identity (App Service managed-identity protocol) ------------
IDENTITY_ENDPOINT=https://entra-emulator:8443/msi/token
IDENTITY_HEADER=managed-identity-secret
AZURE_TOKEN_CREDENTIALS=ManagedIdentityCredential

# ---- endpoints (as seen from INSIDE the compose network; prod = real hosts) --
# management plane (Host: management.azure.localhost) and gateway share the port
DAS_APIM_MGMT=https://apim-emulator:8445
DAS_APIM_SUBSCRIPTION=00000000-0000-0000-0000-000000000000
DAS_APIM_RESOURCE_GROUP=emulator-rg
DAS_APIM_SERVICE=emulator
DAS_EXECUTOR_URL=http://warehouse-query:8090
# The ask service (docs/20-ask-service.md): where the harnesses reach it
# inside the network, and how long it keeps a finished ticket and an idle
# conversation in memory -- it writes neither anywhere.
DAS_ASK_URL=http://ask:8091
DAS_ASK_TTL_S=900
DAS_ASK_MAX_EVENTS=1000
DAS_OM_MCP_URL=http://openmetadata:8585/mcp
# Gateway-side token validation. FALSE HERE, true in .env.prod.example, and the
# difference is not a preference: the pinned apim-emulator's validate-jwt
# accepts only ARM-audience tokens (docs/upstream-issues.md #7), so a local
# stack with this on refuses every call with "Unauthorized. Sign in and retry."
# The executor validates the same token itself either way, so nothing
# unauthenticated reaches data.
DAS_APIM_VALIDATE_JWT=false
DAS_RATE_CALLS=60
DAS_RATE_WINDOW_S=60
DAS_APIM_BASE=https://apim-emulator:8445
DAS_OM_SUBSCRIPTION_KEY=
DAS_OM_MCP_PATH=/om/mcp
DAS_WAREHOUSE_MCP_PATH=/warehouse/mcp
DAS_FABRIC_API=https://fabric-emulator:9443
DAS_OM_URL=http://openmetadata:8585
DAS_KEYVAULT_URL=https://keyvault-emulator:8444

# ---- sources (JSON list; om_service_fqn joins the semantic layer) ---------
# tds_server (optional) overrides the advertised connectionString only when it is
# not dialable from where the service runs (Docker port remap); blank in prod.
# Which source a call is about when it does not say. Leave empty to REQUIRE
# the name once more than one source is configured.
DAS_DEFAULT_SOURCE=contoso_warehouse
DAS_SOURCES=[{"name":"contoso_warehouse","kind":"fabric","dialect":"tsql","authz_tier":"user","om_service_fqn":"fabric_contoso","workspace":"contoso-analytics","item":"contoso_warehouse","tds_server":"contoso-analytics.datawarehouse.fabric.microsoft.com:1433"},{"name":"contoso_support","kind":"postgres","dialect":"postgres","authz_tier":"service","om_service_fqn":"postgres_support","database":"support","schemas":["support"],"dsn":"postgresql://das@postgres:5432/support","credential":"keyvault:das-support-db-password"},{"name":"om_catalog_api","kind":"rest","surface":"http","om_service_fqn":"rest_openmetadata","authz_tier":"service","credential":"keyvault:om-bot-das-reader","base_url":"http://openmetadata:8585/api","spec":"http://openmetadata:8585/swagger.json","collections":["Tables","Glossaries"],"max_items":25,"max_bytes":400000}]
DAS_OM_SCOPE=
DAS_OM_CONTEXT_MODE=base
DAS_SQL_MAX_ROWS=500
DAS_SQL_TIMEOUT_S=30
DAS_SQL_ALLOWED_SCHEMAS=dbo
# Who may read what, above what the source enforces. Rules narrow, never widen.
# Column rules express what a warehouse grant cannot: a grant reaches a table,
# the catalog knows which columns carry personal data. seed/authz.py owns these.
# Where a caller's role comes from: appRole (application role assignments on
# this API) | group (security-group membership, what an identity-governance
# tool such as SailPoint can provision) | both (union, for migrating).
DAS_ROLE_SOURCE=appRole
# WHICH APPLICATION may hold a user's token, as distinct from which user it is.
# A person can sign in with their corporate account from a PERSONAL AI client:
# the token is genuine and authorization is not bypassed, but corporate data
# then lands in a consumer subscription under that person's own terms. The
# protocol carries nothing identifying the vendor account behind a client, so
# the control is the application: `azp` names the app the tenant issued the
# token to, and Entra has no dynamic client registration, so every client id is
# provisioned by an administrator. Empty means unrestricted.
DAS_ALLOWED_CLIENT_IDS=189c7070-78a3-4c13-aa18-20a2ca5755ca
# A second registered client that is deliberately NOT on the list above, so the
# refusal can be witnessed with a real token rather than asserted.
DAS_UNAPPROVED_CLIENT_ID=7c2f9c02-9a1e-4f4e-9d1a-1f0a4b8e2d55

DAS_GROUP_ROLE_MAP={"DAS-Analysts":"Data.Analyst","DAS-Finance":"Data.Finance","DAS-Admins":"Data.Admin"}
DAS_ACCESS_RULES=[{"role":"Data.Admin","allow_tables":["*"],"deny_columns":[]},{"role":"Data.Finance","allow_tables":["dbo.*","support.*","Tables.*","Glossaries.*"],"deny_columns":[]},{"role":"Data.Analyst","allow_tables":["dbo.*","support.*","Tables.*","Glossaries.*"],"deny_tagged":["PII.Sensitive","Contoso Restricted.Commercially Confidential"],"deny_columns":["Glossaries.listGlossaries.data.owners","Tables.listTables.data.owners"]},{"role":"*","allow_tables":["dbo.*","support.*","Tables.*","Glossaries.*"],"deny_columns":[]}]

# ---- executor -------------------------------------------------------------
DAS_EXECUTOR=py          # py | go — which implementation compose builds
DAS_LOG_LEVEL=INFO

# ---- LLM ------------------------------------------------------------------
# The model call goes through the gateway when DAS_LLM_BASE_URL is set, so
# spend is capped and attributed per caller like every other call.
DAS_LLM_BACKEND=http://llm-stub:8095
DAS_LLM_TOKENS_PER_MINUTE=2000
DAS_LLM_CALLS_PER_MINUTE=60
DAS_LLM_BASE_URL=

# ---- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=
DAS_MODEL=claude-opus-5
DAS_EFFORT=high
DAS_USER=carol@entraemulator.dev
DAS_TEST_PASSWORD=Password1!
DAS_SKILLS=om-grounded-sql,result-presentation

# ---- promotion / publishing (Phases 15-16) ---------------------------------
DAS_PROMOTE_ENABLED=false
DAS_PROMOTE_MIN_USERS=3
DAS_PROMOTE_MIN_RUNS=10
DAS_PROMOTE_WINDOW_DAYS=30
DAS_PROMOTE_ROLES=Data.Admin,Data.Analyst
# Which dashboard tools a released candidate is published to. Every named
# target is offered every candidate and each says whether it can take it, so
# a question that recurs is answered wherever people look. A name with no
# target built behind it is refused at startup rather than silently doing
# nothing. Built: powerbi. See docs/00-plan.md §20.
DAS_DASHBOARD_TARGETS=powerbi,superset
# Apache Superset (§20, 19b). `authz_tier: service` -- Superset has no
# on-behalf-of exchange, so it reads with ITS OWN credential and the asking
# person is recorded in the catalog's `owners` instead. The password is a
# vault REFERENCE resolved with the publisher's managed identity; `write_env`
# refuses a secret written here in clear text.
DAS_SUPERSET_URL=http://superset:8088
DAS_SUPERSET_USER=das-publisher
DAS_SUPERSET_PASSWORD=keyvault:superset-admin
DAS_SUPERSET_SOURCE=contoso_support
# Laplace noise on released counts. The k-threshold above is what protects a
# small population; this blurs the counts of candidates that pass it, because
# an exact run count is a side channel and never the number a decision turns on.
DAS_PROMOTE_EPSILON=1.0
# Pseudonymisation key, per scoring window. Local convenience here; in Azure
# this comes from Key Vault via the same managed identity as everything else.
# The job refuses to run without it rather than hashing unkeyed.
DAS_PROMOTE_KEY_SECRET=local-only-promoter-key
DAS_PUBLISH_ENABLED=false
# The identity the publishing job acts as (a person passes --user instead).
DAS_PUBLISH_USER=
DAS_PUBLISH_WORKSPACE_ID=
DAS_PUBLISH_MODE=directquery

# --- catalog-carried access rules (docs/00-plan.md §19) ----------------------
# A rule may name a TAG in `deny_tagged` as well as a column. The vocabulary is
# the catalog's: OpenMetadata's own PII.* and PersonalData.*, or a
# classification this organisation invented. Nothing privileges one in code.
#
# With no `deny_tagged` anywhere, none of this is read and the executor never
# contacts the catalog.
DAS_OM_BOT_TOKEN=keyvault:om-bot-das-reader
# How soon a newly tagged column starts being refused.
DAS_TAG_REFRESH_S=300
# `closed` or `last-known` when the catalog cannot be read. Neither applies on
# a COLD start: with `deny_tagged` configured and no tag set ever read, the
# executor refuses to serve rather than answer with fewer denials than it was
# configured to apply.
DAS_TAG_FAILURE=closed

# --- the catalog, as the caller's role sees it --------------------------------
# OpenMetadata's MCP server is proxied at /om/mcp as the read-only bot for the
# caller's role. Most permissive role FIRST; a caller holding none of these
# reaches no bot. Written by `seed.authz` from the policies it creates -- the
# value here is the shape, not a thing to type.
DAS_OM_ROLE_BOTS=Data.Finance=keyvault:om-bot-das-finance,Data.Analyst=keyvault:om-bot-das-analyst
